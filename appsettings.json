{
  "Application": {
    "Name": "PdfGenApi",
    "Environment": "Production",
    "Version": "1.0.0",
    "BaseUrl": "https://localhost:5001"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "PdfSettings": {
    "DefaultTitle": "Documento PDF",
    "DefaultAuthor": "PdfGenApi",
    "PageSize": "A4",
    "Margin": 20,
    "EnableCompression": true
  },
  "Swagger": {
    "Enabled": true,
    "Title": "PDF Generation API",
    "Version": "v1"
  }
}
